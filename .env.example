# ============================================================
# Talleres Vega — Chatbot de WhatsApp (demo de venta, pilar 5)
# Copia este archivo a .env para desarrollo local.
# En Railway, estas mismas variables se configuran en
# Project → Variables (nunca se suben al repo).
# ============================================================

# --- OpenAI (Bloque 3) ---
# Consíguela en https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# Modelo a usar. gpt-4o-mini es rápido y barato, de sobra para una demo.
OPENAI_MODEL=gpt-4o-mini

# --- Supabase (Bloque 2/6) ---
# URL del proyecto: Supabase Dashboard → Project Settings → Data API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Service role key (NO la anon key — esta tabla no tiene RLS):
# Supabase Dashboard → Project Settings → API Keys → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Bot / WhatsApp (Bloque 4) ---
# Puerto del servidor HTTP del bot. Railway inyecta su propio PORT
# automáticamente — no hace falta tocarlo ahí.
PORT=3008
# Nombre de sesión: define el nombre de la carpeta donde se guardan las
# credenciales de WhatsApp (`${BOT_SESSION_NAME}_sessions`) y del QR
# (`${BOT_SESSION_NAME}.qr.png`). Cámbialo solo si vas a correr más de
# una instancia del bot en la misma máquina.
BOT_SESSION_NAME=taller-vega
